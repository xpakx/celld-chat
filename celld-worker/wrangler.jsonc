/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "celld-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	/* "observability": {
		"enabled": true
	},
	"upload_source_maps": true
	*/
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	// this is a preferred version for cloudflare,
	// but it seems celld doesn't support it yet
	/*"exports": {
		"ChatRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}*/
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
	]
}
